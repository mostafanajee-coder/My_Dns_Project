{
  "manifest_version": 3,
  "name": "Dynamic Smart Proxy",
  "version": "1.1",
  "description": "Bypass ISP DPI/SNI blocking using a dynamic PAC script.",
  "permissions": [
    "proxy",
    "storage",
    "webNavigation",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}

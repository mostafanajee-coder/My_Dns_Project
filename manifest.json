{
  "manifest_version": 3,
  "name": "Dynamic Smart Proxy",
  "version": "1.0",
  "description": "Automatically route blocked domains through a specified proxy.",
  "permissions": [
    "proxy",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
